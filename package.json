{
  "name": "cltree",
  "version": "0.1.0",
  "description": "CLI-first multi-agent orchestrator with PTY management and React/xterm.js web UI",
  "keywords": [
    "cli",
    "agent",
    "terminal",
    "pty",
    "multi-agent",
    "orchestrator",
    "xterm",
    "node-pty"
  ],
  "author": "wo658",
  "license": "MIT",
  "homepage": "https://github.com/wo658/cltree#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wo658/cltree.git"
  },
  "bugs": {
    "url": "https://github.com/wo658/cltree/issues"
  },
  "bin": {
    "cltree": "./bin/cltree.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "lsof -ti:4870,5173 | xargs kill -9 2>/dev/null; true",
    "dev": "pnpm run /^dev:/",
    "dev:server": "PORT=4870 nest start --watch",
    "dev:web": "vite --config src/web/vite.config.ts",
    "mock": "VITE_USE_MOCK=true vite --config src/web/vite.config.ts",
    "build": "pnpm run /^build:/",
    "build:server": "nest build",
    "build:web": "vite build --config src/web/vite.config.ts",
    "start": "node dist/server/server/main.js",
    "test": "jest",
    "demo": "pnpm demo:record && pnpm demo:post",
    "demo:record": "tsx scripts/demo/record.ts",
    "demo:post": "tsx scripts/demo/postprocess.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "check": "pnpm lint && pnpm typecheck",
    "postinstall": "chmod +x node_modules/.pnpm/node-pty@*/node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null; true",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-ws": "^10.4.0",
    "@nestjs/serve-static": "^4.0.0",
    "@nestjs/websockets": "^10.4.0",
    "@vscode/ripgrep": "^1.17.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.0",
    "express": "^4.21.0",
    "fast-glob": "^3.3.3",
    "http-proxy-middleware": "^3.0.5",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.14.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.0.0",
    "puppeteer": "^24.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.0",
    "reflect-metadata": "^0.2.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.0",
    "tailwind-merge": "^2.2.0",
    "uuid": "^10.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
